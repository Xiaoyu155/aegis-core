    "strategy": "preserve original query error if rollback also fails and evict damaged client",
    "patch": "diff --git a/src/services/db.js b/src/services/db.js\nindex ed4b279..b906af8 100644\n--- a/src/services/db.js\n+++ b/src/services/db.js\n@@ -78,10 +78,19 @@ function createExecutor(client) {\n export async function withDbClient(fn) {\n   if (!pool) throw new Error('数据库未初始化');\n   const client = await pool.connect();\n+  let connectionError = null;\n+  const rememberConnectionError = (error) => {\n+    connectionError ||= error;\n+  };\n+  // A checked-out pg Client can emit a socket error in addition to rejecting\n+  // the active query. Keep the event observed until release so a network reset\n+  // cannot become an unhandled EventEmitter error or return a broken client.\n+  client.on('error', rememberConnectionError);\n   try {\n     return await fn(createExecutor(client));\n   } finally {\n-    client.release();\n+    client.removeListener('error', rememberConnectionError);\n+    client.release(connectionError || undefined);\n   }\n }\n \n@@ -93,7 +102,20 @@ export async function transaction(fn) {\n       await tx.query('COMMIT');\n       return result;\n     } catch (err) {\n-      await tx.query('ROLLBACK');\n+      try {\n+        await tx.query('ROLLBACK');\n+      } catch (rollbackError) {\n+        if (err && typeof err === 'object' && Object.isExtensible(err)) {\n+          Object.defineProperty(err, 'rollbackError', {\n+            value: rollbackError,\n+            configurable: true,\n+            enumerable: false,\n+          });\n+        } else {\n+          throw new AggregateError([err, rollbackError],\n+            'Database transaction failed and rollback also failed', { cause: err });\n+        }\n+      }\n       throw err;\n     }\n   });\n",
    "patch_sha256": "b9d5757b8fe211ad789e9793cf855c852c36f5166d79c0de65a3f463907204c8"
