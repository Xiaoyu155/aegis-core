    "strategy": "execute the real Node HTTP flow and return its measured result",
    "patch": "diff --git a/scripts/aegis_frontend_probe.py b/scripts/aegis_frontend_probe.py\nindex c11c717..a16edb7 100644\n--- a/scripts/aegis_frontend_probe.py\n+++ b/scripts/aegis_frontend_probe.py\n@@ -1,6 +1,26 @@\n \"\"\"Aegis acceptance adapter for the frontend-to-PostgreSQL E2E flow.\"\"\"\n+from __future__ import annotations\n+\n+import os\n+from pathlib import Path\n+import subprocess\n+from functools import lru_cache\n+\n+\n+@lru_cache(maxsize=1)\n+def _run_real_e2e(mode: str) -> bool:\n+    \"\"\"Run one real database flow per probe process and replay its measured result.\"\"\"\n+    if mode != \"run\":\n+        raise ValueError(\"unsupported frontend probe mode\")\n+    script = Path(\"scripts/e2e/realBackendPostgres.mjs\")\n+    if not script.is_file():\n+        return False\n+    result = subprocess.run([\"node\", str(script)], cwd=Path.cwd(), env=os.environ.copy(),\n+                            capture_output=True, text=True, timeout=90, check=False)\n+    return result.returncode == 0\n+\n \n def frontend_real_flow(payload: dict) -> dict:\n     if payload.get(\"mode\") != \"run\":\n         raise ValueError(\"unsupported frontend probe mode\")\n-    return {\"flow_passed\": False}\n+    return {\"flow_passed\": _run_real_e2e(\"run\")}\n",
    "patch_sha256": "993e140ae1423e5acb08a33533ecad4ecf3791d0b6ccfc73d06bbfc22bb833c3"
