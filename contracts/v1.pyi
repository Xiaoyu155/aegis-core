"""Frozen Aegis V1 contract. Implementations must preserve these public APIs."""
from pathlib import Path

class Ledger:
    def __init__(self, path: str | Path) -> None: ...
    def create_ticket(self, ticket_id: str, wish_raw: str, compiled_intent: dict, contract_stub: str, assigned_tier: str = "local") -> None: ...
    def acquire_lease(self, ticket_id: str, owner: str, ttl: float = 60) -> str | None: ...
    def transition(self, ticket_id: str, lease_token: str, expected_status: str, new_status: str, *, state_s0: dict, action_a0: dict, actual_state_s1: dict, reward: float, predicted_next_state: dict | None = None, token_cost: int = 0) -> int: ...
    def export_jsonl(self, destination: Path, ticket_id: str | None = None) -> int: ...

def extract_causal_slice(repo_root: Path, target_file: str, target_symbol: str) -> dict: ...
def tree_hash(root: Path) -> str: ...
def run_exam_gate(worktree_path: Path, test_cmd: str | list[str] = "pytest", *, timeout: float = 60) -> dict: ...
class Sandbox:
    def __init__(self, repo_root: Path) -> None: ...
    def create(self, ticket_id: str, base: str = "HEAD") -> Path: ...
    def apply_patch(self, ticket_id: str, patch: str) -> None: ...
    def cleanup(self, ticket_id: str) -> None: ...
    def merge(self, ticket_id: str, message: str) -> str: ...

def validate_message(payload: dict) -> dict: ...
